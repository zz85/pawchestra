{
  "name": "pawchestra",
  "version": "0.0.0",
  "private": true,
  "license": "(Apache-2.0 AND CC-BY-NC-4.0)",
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath tools/git-hooks",
    "prepare-site": "node tools/split-soundfont.ts && node tools/patch-demos.ts",
    "dev": "pnpm prepare-site && node tools/write-perf-60.ts && vite",
    "build": "pnpm prepare-site && vite build && node tools/licenses.ts",
    "deploy:vercel": "tools/deploy-vercel.sh",
    "typecheck": "tsc",
    "test": "vitest run --project unit",
    "test:perf": "vitest run --project perf",
    "test:paused": "node tools/test-paused.ts",
    "test:e2e": "playwright test",
    "lint": "oxlint --type-aware .",
    "format": "oxfmt 'src/**' 'tools/**/*.ts' '!tools/oxlint/**' 'e2e/*.ts' package.json tsconfig.json vite.config.ts playwright.config.ts .oxlintrc.json .oxfmtrc.json",
    "format:check": "oxfmt --check 'src/**' 'tools/**/*.ts' '!tools/oxlint/**' 'e2e/*.ts' package.json tsconfig.json vite.config.ts playwright.config.ts .oxlintrc.json .oxfmtrc.json",
    "size": "node tools/size.ts",
    "load-probe": "node tools/load-probe.ts",
    "lighthouse": "node tools/lighthouse.ts",
    "screenshots": "pnpm build && node tools/screenshots.ts",
    "share-image": "pnpm prepare-site && node tools/share-image.ts",
    "snapshot": "pnpm build && node tools/snapshot.ts",
    "sheet-check": "pnpm build && node tools/sheet-check.ts",
    "pose-probe": "node tools/pose-probe.ts",
    "pose-depth": "node tools/pose-depth.ts",
    "pose-preview": "node tools/pose-preview.ts",
    "hold-reach": "node tools/hold-reach.ts",
    "hold-fit": "node tools/hold-fit.ts",
    "wind-grip": "node tools/wind-grip.ts",
    "hold-scan": "node tools/hold-scan.ts",
    "pair-scan": "node tools/pair-scan.ts",
    "trunk-form": "node tools/trunk-form.ts",
    "body-shape": "node tools/body-shape.ts",
    "raise-fit": "node tools/raise-fit.ts",
    "choir-check": "pnpm build && node tools/choir-check.ts",
    "body-probe": "node tools/body-probe.ts",
    "camera-probe": "node tools/camera-probe.ts",
    "plan-time": "node tools/plan-time.ts",
    "beat-rates": "node tools/beat-rates.ts",
    "clip-probe": "node tools/clip-probe.ts",
    "clip-views": "node tools/clip-views.ts",
    "keyboard": "pnpm build && node tools/keyboard-check.ts",
    "smoke": "pnpm prepare-site && node tools/smoke.ts",
    "rig-mesh": "node tools/rig-mesh.ts",
    "rig-export": "sh -c '\"${BLENDER:-blender}\" -b --factory-startup --python-exit-code 1 --python tools/blender/export_rig.py -- \"$@\"' rig-export",
    "rig-trial": "node tools/rig-trial.ts",
    "bind-view": "sh -c '\"${BLENDER:-blender}\" -b --factory-startup --python-exit-code 1 --python tools/blender/bind_view.py -- \"$@\"' bind-view",
    "mixamo-import": "node tools/mixamo-import.ts",
    "mixamo-model": "node tools/mixamo-model.ts",
    "mesh-options": "node tools/mesh-options.ts",
    "mesh-intake": "node tools/mesh-intake.ts",
    "studio-body": "node tools/studio-body.ts",
    "glb-point-edits": "node tools/glb-point-edits.ts",
    "view-point": "node tools/view-point.ts",
    "close-views": "sh -c 'node tools/close-views.ts --check \"$@\" && pnpm build && node tools/close-views.ts \"$@\"' close-views",
    "fold-probe": "node tools/fold-probe.ts",
    "arm-look": "node tools/arm-look.ts",
    "arm-shape": "node tools/arm-shape.ts",
    "arm-check": "node tools/arm-check.ts",
    "cast-matrix": "node tools/cast-matrix.ts",
    "bind-supination": "node tools/bind-supination.ts",
    "carry-check": "node tools/carry-check.ts",
    "shot-trace": "node tools/shot-trace.ts",
    "look-lab": "node tools/look-lab.ts",
    "look-variants": "node tools/look-variants.ts",
    "light-probe": "node tools/light-probe.ts",
    "loudness": "node tools/loudness.ts",
    "frame": "pnpm prepare-site && node tools/write-perf-60.ts && node tools/measure-frame.ts",
    "frozen": "pnpm prepare-site && node tools/write-perf-60.ts && node tools/frozen.ts",
    "cpu-profile": "pnpm prepare-site && node tools/write-perf-60.ts && node tools/cpu-profile.ts",
    "e2e-base": "node tools/e2e-base.ts",
    "frame-compare": "node tools/frame-compare.ts"
  },
  "dependencies": {
    "@vercel/analytics": "2.0.1",
    "mp4-muxer": "5.2.2",
    "spessasynth_core": "4.3.22",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.86.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.19.1",
    "@types/three": "0.187.0",
    "lighthouse": "12.6.1",
    "oxfmt": "^0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "wasm-media-encoders": "0.7.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.8.0",
  "pnpm": {
    "overrides": {
      "spessasynth_core": "4.3.22",
      "stb-vorbis": "0.0.6"
    }
  }
}
